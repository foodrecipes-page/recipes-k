  "ingredients": [
    {
      "name": "all purpose flour",
      "amount": "2 cups",
      "notes": "preferably from Normandy"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "pitted green olives",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "unsalted butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "egg",
      "amount": "2 large"
    },
    {
      "name": "grated cheese",
      "amount": "1/2 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, whisk together the flour, salt, and black pepper.",
    "Add the sliced olives, melted butter, and egg to the bowl and mix until a dough forms.",
    "Roll out the dough on a floured surface to a thickness of about 1/4 inch.",
    "Use a cookie cutter or the rim of a glass to cut out circles of dough.",
    "Place the dough circles in a hot pot vessel or a stone bowl.",
    "If using cheese, sprinkle it on top of the dough circles.",
    "Bake the macarons in the preheated oven for 20 minutes, or until golden brown."
  ],
