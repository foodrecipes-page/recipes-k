{
  "title": "Kissed Flaky French Olive Macaron",
  "description": "A flaky and savory French macaron featuring olives, perfect for a brunch mood, served in a hot pot vessel. This dish is vegetarian friendly and has a sour taste.",
  "cuisine": "French",
  "diet": [
    "vegetarian"
  ],
