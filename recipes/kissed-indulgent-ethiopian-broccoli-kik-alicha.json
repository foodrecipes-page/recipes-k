  "instructions": [
    "Heat the olive oil in a large pan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the berbere spice and cook for 1 minute, stirring constantly.",
    "Add the purple sprouting broccoli and cook until it is tender.",
    "Season with salt and black pepper to taste.",
    "Squeeze the lemon juice over the broccoli and stir to combine.",
    "Reduce heat to low and simmer for 5 minutes.",
    "Serve hot over injera bread or rice."
  ],
