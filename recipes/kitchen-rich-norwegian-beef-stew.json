      "name": "beef short ribs",
      "amount": "1 pound",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "beef brisket",
      "amount": "1 pound",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "onion",
      "amount": "1 large"
    },
    {
      "name": "carrots",
      "amount": "2 large"
    },
    {
      "name": "potatoes",
      "amount": "2 large"
    },
    {
      "name": "celery",
      "amount": "2 stalks"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "beef broth",
      "amount": "4 cups"
    },
    {
      "name": "heavy cream",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat",
    "Add the beef short ribs and brisket and cook until browned on all sides",
    "Add the onion, carrots, potatoes, and celery and cook until the vegetables are tender",
    "Add the garlic and cook for 1 minute",
    "Add the beef broth and bring to a boil",
    "Reduce the heat to low and simmer for 2 hours",
    "Stir in the heavy cream and cook for an additional 30 minutes",
    "Season with salt and pepper to taste",
    "Serve hot"
  ],
