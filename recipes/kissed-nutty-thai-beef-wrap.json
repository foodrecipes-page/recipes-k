  "ingredients": [
    {
      "name": "beef cutlet",
      "amount": "1 pound",
      "notes": "sliced into thin strips"
    },
    {
      "name": "pandan leaves",
      "amount": "4-6 leaves"
    },
    {
      "name": "peanut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "fish sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "honey",
      "amount": "1 teaspoon"
    },
    {
      "name": "crushed peanuts",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the peanut oil in a large skillet over medium-high heat",
    "Add the beef strips and cook until browned, about 3-4 minutes",
    "Add the fish sauce, lime juice, and honey, and stir to combine",
    "Reduce heat to medium-low and simmer for 5 minutes",
    "Stir in the crushed peanuts, salt, and black pepper",
    "Prepare the pandan leaves by blanching them in boiling water for 30 seconds",
    "Assemble the wraps by placing a few slices of the beef mixture onto a pandan leaf",
    "Fold the leaf over the filling to form a wrap, and serve immediately"
  ],
