{
  "title": "Kissed Nutty Thai Beef Wrap",
  "description": "A nutty and comforting Thai dish featuring beef cutlet, wrapped in a pandan leaf, with a blend of Mediterranean-friendly flavors",
  "cuisine": "Thai",
  "diet": [
    "gluten-free",
    "dairy-free"
