      "name": "Romano peppers",
      "amount": "4 large",
      "notes": "any color"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "scotch bonnet peppers",
      "amount": "2",
      "notes": "seeded and chopped"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "Cut the Romano peppers into 1-inch pieces and thread onto skewers.",
    "In a blender, combine coconut milk, ferment-kimchi, scotch bonnet peppers, olive oil, lime juice, salt, black pepper, and garlic, and blend until smooth.",
    "Brush the skewers with the kimchi mixture.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Serve the skewers hot, garnished with fresh cilantro.",
    "Let the skewers rest for 2 minutes before serving.",
    "Serve with additional kimchi sauce on the side, if desired."
  ],
