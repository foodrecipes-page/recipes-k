{
  "title": "Kissed Charred Egyptian Turkey Ham Skewers",
  "description": "A show-off Egyptian dish featuring charred turkey ham, pickle, and a glassy-jelly glaze, served on a tagliere, perfect for a paleo-friendly snack or appetizer.",
  "cuisine": "Egyptian",
  "diet": [
    "paleo",
    "gluten-free"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "turkey ham",
      "amount": "1 pound",
      "notes": "sliced into 1-inch pieces"
    },
    {
      "name": "pickle",
      "amount": "1/2 cup",
      "notes": "finely chopped"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "pomegranate molasses",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat a grill or grill pan to medium-high heat.",
    "Thread the turkey ham, pickle, and garlic onto skewers.",
    "Brush the skewers with olive oil and season with salt, black pepper, and lemon juice.",
    "Grill the skewers for 5-7 minutes per side, or until charred.",
    "In a small bowl, whisk together the pomegranate molasses and 1 tablespoon of water.",
    "Brush the glaze onto the skewers during the last minute of grilling.",
    "Serve the skewers on a tagliere, garnished with chopped fresh parsley.",
    "Drizzle any remaining glaze over the skewers.",
    "Serve immediately and enjoy."
  ],
