{
  "title": "Kissed Sour Jamaican Yautia Stew",
  "description": "A sour and chewy Jamaican dish featuring yautia, perfect for a lazy Sunday, this stew is poached to perfection and low-fat-friendly.",
  "cuisine": "Jamaican",
  "diet": [
    "low-fat",
    "gluten-free"
  ],
