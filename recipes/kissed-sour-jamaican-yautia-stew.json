  "ingredients": [
    {
      "name": "yautia",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "chicken broth",
      "amount": "4 cups",
      "notes": "low sodium"
    },
    {
      "name": "scotch bonnet peppers",
      "amount": "2",
      "notes": "seeded and chopped"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "thyme",
      "amount": "2 sprigs",
      "notes": "fresh"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "In a large pot, combine the chicken broth, scotch bonnet peppers, onion, garlic, thyme, salt, and black pepper.",
    "Bring the mixture to a boil over high heat, then reduce the heat to medium-low and simmer for 10 minutes.",
    "Add the cubed yautia to the pot and poach for 20 minutes, or until the yautia is tender.",
    "Stir in the lime juice and continue to simmer for an additional 5 minutes.",
    "Remove the pot from the heat and let it cool slightly.",
    "Serve the stew hot, garnished with additional thyme if desired."
  ],
