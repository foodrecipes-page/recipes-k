    {
      "name": "cinnamon",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "nutmeg",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chopped almonds",
      "amount": "1/4 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "In a large mixing bowl, combine rolled oats, almond milk, honey, eggs, cinnamon, nutmeg, and salt. Mix well until a thick batter forms.",
    "Heat the coconut oil in a deep frying pan or a deep fryer to 350°F (180°C).",
    "Using a spoon, drop the oat mixture into the hot oil, making sure not to overcrowd the pan.",
    "Fry the fritters for 2-3 minutes on each side, or until they are golden brown and crispy.",
    "Using a slotted spoon, remove the fritters from the oil and place them on a paper towel-lined plate to drain excess oil.",
    "If desired, sprinkle chopped almonds on top of the fritters before serving."
  ],
