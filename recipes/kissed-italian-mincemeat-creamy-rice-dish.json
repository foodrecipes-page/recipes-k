      "notes": "short-grain rice"
    },
    {
      "name": "mincemeat",
      "amount": "1/2 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "white wine",
      "amount": "2 cups",
      "notes": "dry"
    },
    {
