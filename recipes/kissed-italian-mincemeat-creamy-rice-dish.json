      "amount": "2 tablespoons",
      "notes": "fresh"
    },
    {
      "name": "nutmeg",
      "amount": "1/4 teaspoon",
      "notes": "ground"
    },
    {
      "name": "salt-free seasoning",
      "amount": "1/4 teaspoon",
      "notes": "homemade"
    }
  ],
  "instructions": [
    "heat the olive oil in a large skillet over medium heat.",
    "add the garlic and onion and cook until softened, about 3 minutes.",
    "add the arborio rice and cook for 1 minute, stirring constantly.",
    "add the white wine and cook until absorbed, stirring constantly.",
    "add 1 cup of vegetable broth and cook until absorbed, stirring constantly.",
    "repeat the process until all broth is used, about 20-25 minutes.",
    "stir in the mincemeat and cook for 1 minute.",
    "season with lemon juice, nutmeg, and salt-free seasoning.",
    "serve immediately."
  ],
