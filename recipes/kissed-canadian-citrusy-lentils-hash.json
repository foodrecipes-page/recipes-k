  "instructions": [
    "heat olive oil in a large skillet over medium heat.",
    "add the chopped onion and cook until translucent, about 5 minutes.",
    "add the chopped carrots and celery and cook for another 5 minutes.",
    "add the minced garlic and cook for 1 minute, until fragrant.",
    "add the lentils, orange juice, orange blossom water, paprika, cumin, and coriander. stir to combine.",
    "cook the lentil mixture for 5 minutes, stirring occasionally.",
    "add the fond and stir to deglaze the pan.",
    "season with salt and black pepper to taste.",
    "serve the lentil hash hot, garnished with fresh parsley.",
    "transfer the hash to an airtight container and refrigerate or freeze for later use."
