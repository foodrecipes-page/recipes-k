    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "ginger garlic paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "zucchini",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "bell pepper",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "tomato puree",
      "amount": "1 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "binchotan-charcoal",
      "amount": "1 piece",
      "notes": "for smoking"
    }
  ],
  "instructions": [
    "Heat oil in a large pan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the ginger garlic paste and cook for 1 minute.",
    "Add the chopped carrots, zucchini, and bell pepper, and cook for 5 minutes.",
    "Add the tomato puree and cook for 2 minutes.",
    "Add the coconut milk and stir well.",
    "Reduce heat to low and let it simmer for 10 minutes.",
    "Add the binchotan-charcoal to the pan and let it smoke for 2 minutes.",
    "Remove the charcoal and season with salt and pepper to taste.",
    "Serve hot over rice or with naan."
  ],
