      "name": "extra firm tofu",
      "amount": "1 block",
      "notes": "drained and cut into 1 inch cubes"
    },
    {
      "name": "speculaas spice mix",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large wok over medium high heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the chopped carrots and potatoes and cook for 5 minutes.",
    "Add the speculaas spice mix and cook for 1 minute.",
    "Add the tofu and cook until it is golden brown on all sides.",
    "Season with salt and black pepper to taste.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Serve hot and enjoy."
  ],
