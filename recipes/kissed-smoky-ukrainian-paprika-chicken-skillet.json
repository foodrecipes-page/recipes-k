      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "onion powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chicken broth",
      "amount": "1/4 cup"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat a large tava-griddle over medium-high heat.",
    "Add the chicken to the griddle and cook until browned, about 5 minutes.",
    "Add the smoked paprika, garlic powder, onion powder, salt, and black pepper to the griddle and stir to combine.",
    "Pour in the chicken broth and bring to a simmer.",
    "Reduce the heat to medium-low and cook, covered, until the chicken is cooked through, about 10 minutes.",
    "Stir in the chopped parsley and cook for an additional 1 minute.",
    "Serve the chicken hot, garnished with additional parsley if desired."
  ],
