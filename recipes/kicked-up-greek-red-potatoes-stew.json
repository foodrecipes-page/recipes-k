  "ingredients": [
    {
      "name": "red potatoes",
      "amount": "2 pounds",
      "notes": "peeled and cubed"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "kalamata olives",
      "amount": "1/2 cup",
      "notes": "pitted"
    },
    {
      "name": "artichoke hearts",
      "amount": "1 can",
      "notes": "drained and chopped"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "oregano",
      "amount": "1 teaspoon",
      "notes": "dried"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional 1 minute.",
    "Add the cubed red potatoes, kalamata olives, artichoke hearts, feta cheese, lemon juice, and dried oregano.",
    "Stir to combine and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes, or until the potatoes are tender.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with additional feta cheese and olives if desired."
  ],
