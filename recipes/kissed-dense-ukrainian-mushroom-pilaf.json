{
  "title": "Kissed Dense Ukrainian Mushroom Pilaf",
  "description": "A jammy, dense, and savory Ukrainian dish featuring hot smoked paprika and beurre-monte, perfect for a monsoon evening.",
  "cuisine": "Ukrainian",
  "diet": [
    "ovo-vegetarian"
  ],
