      "name": "beef fillets",
      "amount": "4",
      "notes": "preferably 1-1.5 pounds total"
    },
    {
      "name": "tahini",
      "amount": "2/3 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for brushing skewers"
    },
    {
      "name": "pita bread",
      "amount": "1 loaf",
      "notes": "for serving"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "chopped fresh cilantro",
      "amount": "1/4 cup",
      "notes": "optional, for garnish"
    },
    {
      "name": "sumac",
      "amount": "1/4 teaspoon",
      "notes": "optional, for garnish"
    }
  ],
  "instructions": [
    "preheat grill to medium-high heat (400f to 450f).",
    "thread beef onto skewers, leaving a little space between each piece.",
    "whisk together tahini, lemon juice, garlic, salt, and black pepper in a bowl.",
    "brush the tahini mixture onto the beef skewers, making sure to coat them evenly.",
    "brush the grill grates with olive oil to prevent sticking.",
    "grill the skewers for 8-10 minutes, flipping halfway through.",
    "serve hot with pita bread, garnished with parsley, cilantro, and sumac if desired.",
    "drizzle with additional tahini sauce if desired."
  ],
