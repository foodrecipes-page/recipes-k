  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "whole wheat flour",
      "amount": "2 tablespoons"
    },
    {
      "name": "tagine spice blend",
      "amount": "2 teaspoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "fish sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "peanut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat peanut oil in a large tagine or Dutch oven over medium heat.",
    "Add the chicken to the pot and cook until browned on all sides.",
    "Add the whole wheat flour and tagine spice blend to the pot and stir to combine.",
    "Pour in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and cook, covered, for 20 minutes.",
    "Stir in the fish sauce, lime juice, brown sugar, and salt.",
    "Continue to cook, uncovered, for an additional 10 minutes.",
    "Serve the curry hot, garnished with fresh herbs if desired."
  ],
