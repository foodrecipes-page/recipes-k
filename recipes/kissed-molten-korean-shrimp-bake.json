      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "gochujang",
      "amount": "2 tablespoons"
    },
    {
      "name": "soy sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "1 teaspoon"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together gochujang, soy sauce, brown sugar, garlic, and ginger.",
    "Add the shrimp to the bowl and toss to coat with the sauce.",
    "Transfer the shrimp to a baking dish and drizzle with sesame oil.",
    "Bake the shrimp for 8 minutes or until pink and cooked through.",
    "Remove the shrimp from the oven and sprinkle with green onions.",
    "Return the shrimp to the oven and bake for an additional 1 minute.",
    "Remove the shrimp from the oven and serve hot."
  ],
