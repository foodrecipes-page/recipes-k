{
  "title": "Kissed Molten Korean Shrimp Bake",
  "description": "A high-protein weeknight Korean dish featuring shrimp in a resinous and molten sauce, baked to perfection. This dish is perfect for a quick and flavorful dinner.",
  "cuisine": "Korean",
  "diet": [
    "high-protein"
  ],
