      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "Thai holy basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "In a large bowl, whisk together coconut milk, lime juice, olive oil, garlic, salt, and black pepper",
    "Add the chicken to the bowl and marinate for at least 30 minutes",
    "Thread the marinated chicken onto skewers",
    "Pressure-cook the skewers for 10 minutes",
    "Remove the skewers from the pressure cooker and roast in the oven for 15 minutes",
    "Sprinkle chopped Thai holy basil over the skewers and serve",
    "Garnish with additional basil if desired",
    "Serve immediately and enjoy",
    "Cook poultry to an internal temperature of 74°C / 165°F before serving."
  ],
