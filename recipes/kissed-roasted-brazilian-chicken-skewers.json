{
  "title": "Kissed Roasted Brazilian Chicken Skewers",
  "description": "A paleo-friendly Brazilian dish featuring Thai holy basil krapao, pressure-cooked and roasted to perfection, served as a solo dinner",
  "cuisine": "Brazilian",
