    {
      "name": "Fast Action Yeast",
      "amount": "1 packet (2 1/4 teaspoons)"
    },
    {
      "name": "Vegetable Oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "Onion",
      "amount": "1 medium, diced"
    },
    {
      "name": "Garlic",
      "amount": "2 cloves, minced"
    },
    {
      "name": "Basmati Rice",
      "amount": "1 cup, rinsed and drained"
    },
    {
      "name": "All-Purpose Flour",
      "amount": "2 tablespoons"
    },
    {
      "name": "Salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "Black Pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Fresh Cilantro",
      "amount": "1/4 cup, chopped"
    },
    {
      "name": "Lemon Juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "Water",
      "amount": "1 cup"
    },
    {
      "name": "Crushed Red Pepper Flakes",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large saucepan over medium-high heat.",
    "Add the onion and cook until translucent, about 3 minutes.",
    "Add the garlic and cook for 1 minute, until fragrant.",
    "Add the rice and cook for 2 minutes, stirring constantly, until lightly toasted.",
    "In a small bowl, mix together the flour, salt, and black pepper.",
    "Add the dry mixture to the rice and stir to combine.",
    "Add the yeast, water, and lemon juice, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and cover.",
    "Simmer for 18-20 minutes, or until the liquid has been absorbed and the rice is tender.",
    "Stir in the chopped cilantro and crushed red pepper flakes.",
    "Serve hot."
  ],
