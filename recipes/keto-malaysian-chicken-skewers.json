{
  "title": "Keto Malaysian Chicken Skewers",
  "description": "A fresh and velvety Malaysian dish featuring ghee and grilled to perfection on a raclette grill, perfect for a keto diet.",
  "cuisine": "Malaysian",
  "diet": [
    "keto",
    "gluten-free",
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "ghee",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1/2 cup"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the raclette grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together coconut milk, lime juice, garlic, ginger, salt, and pepper.",
    "Add the chicken pieces to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated chicken onto skewers.",
    "Brush the skewers with ghee.",
    "Grill the skewers on the raclette grill for 10-12 minutes, flipping occasionally.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
