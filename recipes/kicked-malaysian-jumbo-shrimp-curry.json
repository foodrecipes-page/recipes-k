{
  "title": "Kicked Malaysian Jumbo Shrimp Curry",
  "description": "A spicy and fluffy Malaysian dish featuring jumbo shrimp, simmered in a rich and aromatic curry sauce, served in a Korean brass bowl.",
  "cuisine": "Malaysian",
  "diet": [
    "gluten-free"
  ],
