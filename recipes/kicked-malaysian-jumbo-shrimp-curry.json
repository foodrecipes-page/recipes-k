    {
      "name": "jumbo shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "turmeric",
      "amount": "1 teaspoon"
    },
    {
      "name": "cayenne pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "coconut milk",
      "amount": "1 can",
      "notes": "full-fat"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large Korean brass bowl over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the curry powder, turmeric, and cayenne pepper and cook for 1 minute, stirring constantly.",
    "Add the jumbo shrimp and cook until pink and just cooked through, about 5 minutes.",
    "Pour in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the curry simmer for 10 minutes, stirring occasionally.",
    "Season the curry with salt and serve hot over fluffy rice or with naan bread."
  ],
