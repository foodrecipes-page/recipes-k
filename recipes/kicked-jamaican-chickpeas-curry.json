      "name": "chickpeas",
      "amount": "1 can",
      "notes": "drained and rinsed"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "jamaican curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "vegetable oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "scotch bonnet pepper",
      "amount": "1",
      "notes": "optional, seeded and chopped"
    }
  ],
  "instructions": [
    "Heat the oil in a large pan over medium heat.",
    "Add the onion and garlic and saute until the onion is translucent.",
    "Add the curry powder and cook for 1 minute, stirring constantly.",
    "Add the chickpeas, coconut milk, salt, and black pepper, and stir to combine.",
    "Bring the mixture to a simmer and cook for 20 minutes, or until the sauce has thickened.",
    "Taste and adjust the seasoning as needed, adding the scotch bonnet pepper if using.",
    "Serve the curry hot, garnished with chopped fresh cilantro or scallions if desired."
  ],
