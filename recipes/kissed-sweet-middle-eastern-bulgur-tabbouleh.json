{
  "title": "Kissed Sweet Middle Eastern Bulgur Tabbouleh",
  "description": "A winey, gooey, comforting Middle Eastern dish featuring dried cranberries and candy, served in a cazuela.",
  "cuisine": "Middle Eastern",
  "diet": [
    "diabetic-friendly"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "bulgur",
      "amount": "1 cup",
      "notes": "fine grind"
    },
    {
      "name": "dried cranberries",
      "amount": "1/2 cup"
    },
    {
      "name": "candy",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "red wine",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "chopped parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 350 degrees.",
    "In a large bowl, combine the bulgur, dried cranberries, and candy.",
    "In a small bowl, whisk together the red wine, olive oil, lemon juice, salt, and black pepper.",
    "Pour the wet ingredients over the bulgur mixture and stir to combine.",
    "Transfer the mixture to a cazuela and cover with aluminum foil.",
    "Bake for 25 minutes, then remove the foil and bake for an additional 10 minutes.",
    "Remove from the oven and stir in the chopped parsley.",
    "Let cool for a few minutes before serving."
  ],
