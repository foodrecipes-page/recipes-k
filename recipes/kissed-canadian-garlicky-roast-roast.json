  "instructions": [
    "preheat oven to 425°f",
    "season the roast with thyme, salt, and pepper",
    "heat the olive oil in a large oven-safe skillet over medium-high heat",
    "sear the roast on all sides until browned, about 2-3 minutes per side",
    "transfer the skillet to the preheated oven and roast for 20 minutes",
    "remove the skillet from the oven and brush the roast with the vin santo and honey mixture",
    "return the skillet to the oven and roast for an additional 10-15 minutes",
    "remove the skillet from the oven and let the roast rest for 5 minutes before slicing",
    "while the roast is resting, cook the sliced carrots and potatoes in the skillet until tender and lightly browned",
    "serve the sliced roast with the roasted vegetables and spoon some of the pan juices over the top"
  ],
