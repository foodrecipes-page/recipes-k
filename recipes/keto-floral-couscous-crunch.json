  "ingredients": [
    {
      "name": "1 cup pearl couscous",
      "amount": "cup"
    },
    {
      "name": "2 tbsp olive oil",
      "amount": "tbsp"
    },
    {
      "name": "1/4 tsp sea salt",
      "amount": "tsp"
    },
    {
      "name": "1/8 tsp black pepper",
      "amount": "tsp"
    },
    {
      "name": "2 cloves garlic, minced",
      "amount": "cloves"
    },
    {
      "name": "1/4 cup chopped fresh dill",
      "amount": "cup"
    },
    {
      "name": "1/4 cup finely chopped parsley",
      "amount": "cup"
    },
    {
      "name": "1/4 tsp ground cinnamon",
      "amount": "tsp"
    },
    {
      "name": "20 fresh rose petals, optional for garnish (adjust according to taste)",
      "amount": "pieces"
    }
  ],
  "instructions": [
    "Preheat oven to 375°F (190°C).",
    "Combine couscous with olive oil, sea salt, and black pepper in a large bowl.",
    "Add minced garlic, chopped herbs, and cinnamon. Mix well until combined.",
    "Spread the mixture evenly on a baking sheet lined with parchment paper.",
    "Bake for 12-15 minutes or until golden brown and crispy.",
    "Let it cool slightly before serving. Garnish with rose petals if desired."
