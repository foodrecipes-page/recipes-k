{
  "title": "Keto-Friendly Floral Couscous Crunch",
  "description": "This energizing Ethiopian dish combines crispy couscous with floral herbs for a light and refreshing breakfast or snack.",
  "cuisine": "Ethiopian",
  "diet": [
    "keto"
  ],
