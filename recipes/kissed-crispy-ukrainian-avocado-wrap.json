  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the sliced red onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the sliced Ukrainian sausage and cook until it is browned.",
    "Meanwhile, peel and slice the avocado.",
    "Lay a collard green leaf flat and arrange a quarter of the sausage mixture in the center.",
    "Top with a quarter of the sliced avocado and a sprinkle of salt and pepper.",
    "Fold the stem end over the filling, then fold in the sides and roll the leaf into a tight cylinder.",
    "Repeat with the remaining ingredients.",
    "Steam the wraps over boiling water for 5 minutes."
  ],
