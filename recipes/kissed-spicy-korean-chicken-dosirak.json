      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "white wine",
      "amount": "1/4 cup"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the robata-grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together hot chilli powder, soy sauce, brown sugar, garlic, and ginger.",
    "Add the chicken to the bowl and toss to coat with the marinade.",
    "Grill the chicken for 5-6 minutes per side, or until cooked through.",
    "In a small bowl, whisk together sesame oil and white wine.",
    "Brush the sesame oil mixture onto the chicken during the last minute of grilling.",
    "Serve the chicken in a dosirak container with chopped scallions on top.",
    "Let the dish rest for 2 minutes before serving."
  ],
