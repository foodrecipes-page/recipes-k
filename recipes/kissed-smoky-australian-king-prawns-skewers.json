      "amount": "1 piece",
      "notes": "for smoking"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat",
    "Thread 3 king prawns onto each skewer",
    "In a small bowl, mix together lemon juice, olive oil, garlic, paprika, salt, and black pepper",
    "Brush the mixture onto both sides of the prawns",
    "Place the skewers on the grill and cook for 2-3 minutes per side",
    "Hold the binchotan charcoal piece over the prawns for 30 seconds to give them a smoky flavor",
    "Serve the prawns hot, garnished with chopped parsley"
  ],
