    },
    {
      "name": "thyme",
      "amount": "1 sprig",
      "notes": "fresh"
    },
    {
      "name": "heavy cream",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Melt butter in a copper mug over medium heat.",
    "Add brown sugar, soy sauce, lime juice, scotch bonnet peppers, and garlic, stirring until sugar dissolves.",
    "Add pineapple chunks and cook until caramelized, about 5 minutes.",
    "Add thyme sprig and heavy cream, stirring until cream is heated through.",
    "Reduce heat to low and simmer, uncovered, for 10 minutes.",
    "Remove thyme sprig and serve hot, garnished with additional thyme if desired."
  ],
