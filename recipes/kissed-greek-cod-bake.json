  "ingredients": [
    {
      "name": "Cod fillets (4-6)",
      "amount": "400g",
      "notes": "Fresh and skin removed"
    },
    {
      "name": "Mixed herbs (such as thyme, oregano, parsley)",
      "amount": "2 tbsp",
      "notes": "Fresh or dried"
    },
    {
      "name": "Greek yogurt",
      "amount": "4 tbsp",
      "notes": "Low-fat or non-fat"
    },
    {
      "name": "Lemon juice",
      "amount": "2 tbsp",
      "notes": "Freshly squeezed"
    },
    {
      "name": "Garlic, minced",
      "amount": "1 clove",
      "notes": ""
    },
    {
      "name": "Olive oil",
      "amount": "2 tbsp",
      "notes": "Extra virgin"
    },
    {
      "name": "Salt-free seasoning",
      "amount": "1 tsp",
      "notes": "Homemade or store-bought"
    },
    {
      "name": "Crushed feta cheese",
      "amount": "1/4 cup",
      "notes": "Optional"
    },
    {
      "name": "Fresh rosemary leaves",
      "amount": "4",
      "notes": "For garnish"
    }
  ],
  "instructions": [
    "Preheat oven to 200°C (400°F).",
    "Line a baking sheet with parchment paper.",
    "Season the cod fillets with salt-free seasoning.",
    "In a small bowl, mix together mixed herbs, Greek yogurt, lemon juice, garlic, and olive oil.",
    "Brush the herb mixture evenly over both sides of the cod fillets.",
    "Place the cod fillets on the prepared baking sheet.",
    "Bake for 12-15 minutes or until the cod flakes easily with a fork.",
    "Remove from oven and top with crushed feta cheese (if using).",
    "Return to oven and bake for an additional 2-3 minutes or until the cheese is melted and bubbly.",
    "Garnish with fresh rosemary leaves and serve immediately."
  ],
