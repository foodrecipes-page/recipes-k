{
  "title": "Kissed Greek Cod Bake",
  "description": "A romantic Greek dish featuring cod, salt-bake, and floral flavors that is low-sodium-friendly.",
  "cuisine": "Greek",
  "diet": [
    "low-sodium",
    "high-protein"
  ],
