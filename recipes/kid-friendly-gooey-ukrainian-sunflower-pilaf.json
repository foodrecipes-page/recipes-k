  "ingredients": [
    {
      "name": "sunflower oil",
      "amount": "2 tablespoons",
      "notes": "use a high-quality oil"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "garlic-infused oil",
      "amount": "1 teaspoon",
      "notes": "ensure FODMAP-friendly"
    },
    {
      "name": "rice",
      "amount": "1 cup",
      "notes": "white or brown"
    },
    {
      "name": "chicken broth",
      "amount": "2 cups",
      "notes": "low-sodium"
    },
    {
      "name": "dried parsley",
      "amount": "1 teaspoon",
      "notes": "fresh is optional"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "grated cheddar cheese",
      "amount": "1 cup",
      "notes": "low-lactose"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large saucepan, heat the sunflower oil over medium heat.",
    "Add the diced onion and cook until translucent, about 5 minutes.",
    "Add the garlic-infused oil and cook for an additional minute.",
    "Add the rice and stir to coat with the oil and mix with the onion.",
    "Add the chicken broth, dried parsley, salt, and black pepper, and bring to a boil.",
    "Reduce the heat to low, cover, and simmer for 15 minutes.",
    "Transfer the saucepan to the preheated oven and bake for 10 minutes.",
    "Remove from the oven and stir in the grated cheddar cheese until melted and gooey.",
    "Serve hot on a slate-tile vessel."
  ],
