{
  "title": "Kid Friendly Gooey Ukrainian Sunflower Pilaf",
  "description": "A cultured and kid-friendly Ukrainian dish featuring sunflower oil, this pilaf is perfect for a weeknight dinner. It is also FODMAP-friendly and cooked to a gooey perfection on a slate-tile vessel.",
  "cuisine": "Ukrainian",
  "diet": [
    "gluten-free",
    "low-lactose"
  ],
