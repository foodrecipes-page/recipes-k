      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large cazuela over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped carrots and celery and cook for 5 minutes.",
    "In a separate bowl, whisk together the chickpea flour and water until smooth.",
    "Add the chickpea flour mixture to the cazuela and stir to combine.",
    "Bring the mixture to a simmer and cook for 20 minutes.",
    "Season the stew with salt and black pepper to taste.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
  ],
