      "amount": "1 cup",
      "notes": "preferably fermented"
    },
    {
      "name": "water",
      "amount": "4 cups"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
