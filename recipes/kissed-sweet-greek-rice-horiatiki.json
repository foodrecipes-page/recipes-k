{
  "title": "Kissed Sweet Greek Rice Horiatiki",
  "description": "A sweet and fluffy Greek dish featuring rice paper sheets, infused oil, and friendly ingredients, served in a bento box, perfect for a weeknight dinner.",
  "cuisine": "Greek",
  "diet": [
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "rice paper sheets",
      "amount": "12 sheets",
      "notes": "dried"
    },
    {
      "name": "infused oil",
      "amount": "1/4 cup"
    },
    {
      "name": "cooked rice",
      "amount": "2 cups"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 cup"
    },
    {
      "name": "cucumber",
      "amount": "1 medium",
      "notes": "sliced"
    },
    {
      "name": "red onion",
      "amount": "1/2 medium",
      "notes": "thinly sliced"
    },
    {
      "name": "kalamata olives",
      "amount": "1/2 cup",
      "notes": "pitted"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, combine cooked rice, diced tomatoes, cucumber, red onion, kalamata olives, and feta cheese.",
    "In a small bowl, whisk together infused oil and lemon juice.",
    "Pour the oil and lemon juice mixture over the rice mixture and toss to combine.",
    "Cut the rice paper sheets into smaller pieces and soak them in water for 30 seconds.",
    "Drain the rice paper pieces and add them to the rice mixture, tossing gently to combine.",
    "Spoon the mixture into a bento box, garnished with chopped fresh parsley.",
    "Serve immediately and enjoy.",
    "Refrigerate any leftovers for up to 3 days."
  ],
