{
  "title": "Kissed Nutty Brazilian Chicken Stew",
  "description": "A nutty and festive Brazilian dish featuring beer and confit-tomato, made in a cataplana vessel, this stew is low in calories and rich in flavor, perfect for a special occasion",
  "cuisine": "Brazilian",
  "diet": [
    "low-calorie",
    "gluten-free"
  ],
