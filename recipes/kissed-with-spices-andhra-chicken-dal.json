  "instructions": [
    "heat the ghee or coconut oil in a clay pot over medium heat.",
    "add the mustard seeds and let them sizzle for a few seconds.",
    "add the curry leaves and sauté for 1 minute.",
    "add the onion and ginger and sauté until the onion is translucent.",
    "add the yellow curry paste and sauté for 2 minutes.",
    "add the chicken and cook until it is browned on all sides.",
    "add the tomatoes, chicken broth, cumin powder, turmeric powder, coriander powder, red chili powder, and salt. stir well.",
    "bring the mixture to a boil, then reduce the heat to low and simmer for 20 minutes.",
    "add the green chilies and simmer for another 5 minutes.",
    "season the dal with salt to taste.",
    "serve the dal hot, garnished with fresh cilantro if desired.",
    "serve with steamed basmati rice or roti, if desired."
  ],
