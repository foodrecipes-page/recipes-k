  "ingredients": [
    {
      "name": "unsalted butter",
      "amount": "2 tablespoons",
      "notes": "softened"
    },
    {
      "name": "pineapple chunks",
      "amount": "1 cup",
      "notes": "fresh or canned"
    },
    {
      "name": "brown sugar",
      "amount": "1 tablespoon"
    },
    {
      "name": "port wine",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "brine",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Heat the butter in a large skillet over medium heat until melted.",
    "Add the pineapple chunks to the skillet and cook for 2 minutes.",
    "Add the brown sugar, port wine, lemon juice, salt, and black pepper to the skillet and stir to combine.",
    "Cook for an additional 2 minutes, stirring constantly.",
    "Add the brine to the skillet and stir to combine.",
    "Reduce heat to low and simmer for 1 minute.",
    "Remove the skillet from the heat and let cool for 1 minute.",
    "Serve the pineapple mixture warm, garnished with additional pineapple chunks if desired."
  ],
