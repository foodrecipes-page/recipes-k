{
  "title": "Kissed Buttery Portuguese Pineapple Skillet",
  "description": "A light and quick Portuguese dish featuring pineapple chunks, this recipe is perfect for a snack or dessert. It is egg-free and features a buttery flavor.",
  "cuisine": "Portuguese",
  "diet": [
    "vegetarian",
