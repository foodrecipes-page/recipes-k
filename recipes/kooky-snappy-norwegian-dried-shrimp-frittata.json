{
  "title": "Kooky Snappy Norwegian Dried Shrimp Frittata",
  "description": "A brunch dish featuring dried shrimp and infused oil, perfect for a Norwegian-inspired meal. This ovo-vegetarian friendly frittata is filled with grassy and snappy flavors.",
  "cuisine": "Norwegian",
  "diet": [
    "ovo-vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "dried shrimp",
      "amount": "1/2 cup",
      "notes": "rehydrated in water"
    },
    {
      "name": "eggs",
      "amount": "6 large",
      "notes": "beaten"
    },
    {
      "name": "infused oil",
      "amount": "2 tablespoons",
      "notes": "with parsley and dill"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 small",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a bowl, whisk together the eggs, salt, and pepper.",
    "Heat the infused oil in a skillet over medium heat.",
    "Add the chopped onion and cook until softened.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the rehydrated dried shrimp and cook for 2 minutes.",
    "Pour the egg mixture over the shrimp mixture in the skillet.",
    "Transfer the skillet to the preheated oven and bake for 20 minutes.",
    "Remove the skillet from the oven and sprinkle with chopped parsley.",
    "Let the frittata cool for a few minutes before slicing and serving."
  ],
