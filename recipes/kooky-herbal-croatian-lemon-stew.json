    {
      "name": "lemons",
      "amount": "4",
      "notes": "juiced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "thyme",
      "amount": "2 sprigs",
      "notes": "fresh"
    },
    {
      "name": "rosemary",
      "amount": "1 sprig",
      "notes": "fresh"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "sodium alginate",
      "amount": "1 teaspoon"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the thyme, rosemary, and lemon juice, and stir to combine.",
    "Add the potatoes, vegetable broth, and sodium alginate, and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes, or until the potatoes are tender.",
    "Use a spoon to drop small amounts of the stew into a bath of cold water to spherify the potatoes.",
    "Serve the stew hot, garnished with fresh herbs and spherified potatoes.",
    "Season with salt and pepper to taste.",
    "Serve immediately and enjoy."
  ],
