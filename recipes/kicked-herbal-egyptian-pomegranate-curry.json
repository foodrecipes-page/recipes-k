      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a kadhai over medium heat.",
    "Add the chopped onion and saute until it is translucent.",
    "Add the grated ginger and minced garlic and saute for another minute.",
    "Add the curry powder, turmeric, cumin, coriander, salt, and black pepper, and stir well.",
    "Pour in the pomegranate juice and bring the mixture to a boil.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Stir occasionally to prevent the curry from sticking to the kadhai.",
    "Remove from heat and serve hot."
  ],
