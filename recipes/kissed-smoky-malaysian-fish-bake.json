      "amount": "3 cloves"
    },
    {
      "name": "ginger",
      "amount": "1 inch"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit",
    "Line a baking sheet with parchment paper",
    "Place the fish fillets on the baking sheet",
    "Mix the smoked paprika, coconut milk, lemon juice, garlic, and ginger in a bowl",
    "Pour the mixture over the fish fillets",
    "Sprinkle the bryndza cheese over the top",
    "Drizzle the olive oil over the cheese",
    "Bake for 20 minutes or until the fish is cooked through"
  ],
