{
  "title": "Kissed with Citrus Malaysian Borlotti Beans Satay",
  "description": "A twist on traditional satay featuring tender borlotti beans, citrusy flavors, and served in agave leaves.",
  "cuisine": "malaysian",
  "diet": [
    "vegetarian",
    "vegan"
