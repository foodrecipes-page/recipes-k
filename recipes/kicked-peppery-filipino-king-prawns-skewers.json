    {
      "name": "king prawns",
      "amount": "12 large",
      "notes": "peeled and deveined"
    },
    {
      "name": "black pepper",
      "amount": "2 tablespoons",
      "notes": "freshly ground"
    },
    {
      "name": "salt",
      "amount": "1 tablespoon"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "patience fruit",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the salt block in the oven at 400 degrees Fahrenheit for 30 minutes.",
    "In a bowl, mix together black pepper, salt, garlic, and ginger.",
    "Add the king prawns to the bowl and toss to coat with the pepper mixture.",
    "Thread the coated prawns onto skewers, leaving a small space between each prawn.",
    "Brush the prawns with lemon juice and olive oil.",
    "Place the skewers on the preheated salt block and cook for 8-10 minutes per side.",
    "Garnish with chopped scallions and patience fruit.",
    "Serve immediately and enjoy."
  ],
