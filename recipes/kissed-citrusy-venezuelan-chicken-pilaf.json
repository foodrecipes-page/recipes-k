      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "boneless and skinless"
    },
    {
      "name": "chicken stock concentrate",
      "amount": "2 tablespoons"
    },
    {
      "name": "uncooked white rice",
      "amount": "1 cup"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "orange juice",
      "amount": "1/2 cup"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon zest",
      "amount": "1 tablespoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "Rinse the rice in a fine mesh strainer until the water runs clear.",
    "In a medium saucepan, heat the olive oil over medium heat.",
    "Add the chicken to the saucepan and cook until browned, about 5 minutes.",
    "Add the chicken stock concentrate, water, orange juice, salt, and pepper to the saucepan and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and cover the saucepan.",
    "Transfer the saucepan to a bain-marie and cook for 20 minutes.",
    "Stir in the chopped parsley and lemon zest.",
    "Fluff the pilaf with a fork and serve hot."
  ],
