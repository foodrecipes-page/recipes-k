{
  "title": "Kissed Garlicky Ukrainian Cheese Casserole",
  "description": "A comforting Ukrainian dish featuring shredded Monterey Jack cheese, garlic, and a crispy crust, cooked to perfection in a ttukbaegi earthenware pot. This satvik-friendly recipe is perfect for a cold winter night.",
  "cuisine": "Ukrainian",
  "diet": [
    "vegetarian",
    "satvik"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Monterey Jack cheese",
      "amount": "2 cups shredded",
      "notes": "preferably low moisture"
    },
    {
      "name": "garlic",
      "amount": "6 cloves",
      "notes": "minced"
    },
    {
      "name": "all purpose flour",
      "amount": "1 cup"
    },
    {
      "name": "butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "eggs",
      "amount": "2 large"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, combine the shredded cheese, minced garlic, and chopped parsley.",
    "In a separate bowl, whisk together the flour, melted butter, eggs, salt, and black pepper.",
    "Add the wet ingredients to the dry ingredients and stir until just combined.",
    "Pour the mixture into a ttukbaegi earthenware pot or a 9x13 inch baking dish.",
    "Bake for 35 minutes or until the top is golden brown and the casserole is set.",
    "Remove from the oven and let cool for 10 minutes before serving.",
    "Serve hot and enjoy."
  ],
