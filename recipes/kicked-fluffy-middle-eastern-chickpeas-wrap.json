{
  "title": "Kicked Fluffy Middle Eastern Chickpeas Wrap",
  "description": "A pungent and fluffy quick-fix Middle Eastern dish featuring vegan white wine vinegar, served in a fondue pot with ssam wraps, ayurvedic-tamasic-friendly ingredients.",
  "cuisine": "Middle Eastern",
  "diet": [
    "vegan"
  ],
