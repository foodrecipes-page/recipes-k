  "ingredients": [
    {
      "name": "chickpeas",
      "amount": "1 1/2 cups",
      "notes": "canned, drained and rinsed"
    },
    {
      "name": "white wine vinegar",
      "amount": "2 tablespoons",
      "notes": "vegan"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "finely chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "ssam wraps",
      "amount": "4-6 pieces"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a fondue pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Stir in the cumin, paprika, salt, and black pepper.",
    "Add the chickpeas and cook for 5 minutes, stirring occasionally.",
    "Stir in the white wine vinegar and cook for an additional 2 minutes.",
    "Warm the ssam wraps by wrapping them in a damp paper towel and microwaving for 20-30 seconds.",
    "Assemble the wraps by spooning the chickpea mixture onto a ssam wrap and serving immediately."
  ],
