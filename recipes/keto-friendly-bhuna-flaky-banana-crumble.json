      "amount": "60g"
    },
    {
      "name": "heavy cream",
      "amount": "250ml"
    },
    {
      "name": "honey or stevia (as a sweetener)",
      "amount": "3 tbsp"
    },
    {
      "name": "all-purpose flour",
      "amount": "100g"
    },
    {
      "name": "coconut flakes",
      "amount": "75g"
    }
  ],
  "instructions": [
    "Preheat oven to 200\u00b0C (400\u00b0F).",
    "Mix all purpose flour and coconut flakes in a bowl.",
    "Cut the ripe banana into thin slices, place on a baking sheet lined with parchment paper.",
    "Drizzle with honey or stevia and lightly sprinkle with ground cinnamon. Bake for about 15 minutes or until golden brown.",
    "Meanwhile, mix unsalted butter with heavy cream until creamy. Add honey or stevia to taste.",
    "Pour the mixture over the banana slices and bake for an additional 5-7 minutes until bubbly.",
    "Serve warm as a dessert."
