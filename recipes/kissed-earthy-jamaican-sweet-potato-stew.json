{
  "title": "Kissed Earthy Jamaican Sweet Potato Stew",
  "description": "A hearty, lacto-vegetarian-friendly stew featuring katsuramuki-cut sweet potatoes and the warmth of brandy, perfect for a sick day",
  "cuisine": "Jamaican",
  "diet": [
    "lacto-vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "sweet potatoes",
      "amount": "2 large",
      "notes": "katsuramuki-cut"
    },
    {
      "name": "brandy",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "ginger",
      "amount": "1 inch"
    },
    {
      "name": "scotch bonnet peppers",
      "amount": "2"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "thyme",
      "amount": "1 sprig"
    }
  ],
  "instructions": [
    "In a large pot, heat oil over medium heat and saute the onion until translucent",
    "Add the garlic and ginger and cook for 1 minute, stirring constantly",
    "Add the scotch bonnet peppers and cook for another minute",
    "Add the katsuramuki-cut sweet potatoes, vegetable broth, and thyme, and bring to a boil",
    "Reduce the heat to low and simmer for 20 minutes, or until the sweet potatoes are tender",
    "Stir in the coconut milk and brandy, and cook for an additional 5 minutes",
    "Season with salt and pepper to taste",
    "Serve hot, garnished with fresh thyme if desired"
  ],
