{
  "title": "Slovakian Ham Skillet",
  "description": "A sour and light one-pot Slovakian dish featuring serrano ham, katsuramuki-cut, and ayurvedic-tamasic-friendly ingredients, perfect for a weeknight dinner",
  "cuisine": "Slovakian",
