    {
      "name": "sauerkraut",
      "amount": "1 cup",
      "notes": "drained and rinsed"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and diced"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "caraway seeds",
      "amount": "1 tsp",
      "notes": "ground"
    },
    {
