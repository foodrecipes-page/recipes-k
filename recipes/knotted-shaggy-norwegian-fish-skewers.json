      "amount": "1/2 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Thread the cod pieces onto skewers, leaving a small space between each piece.",
    "In a bowl, mix together the double cream, confit-tomato, olive oil, lemon juice, garlic, salt, and black pepper.",
    "Brush the mixture onto the cod pieces.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Bake for 12 minutes or until the cod is cooked through.",
    "Garnish with chopped fresh parsley.",
    "Serve immediately.",
    "Optional: serve with a side of roasted vegetables or quinoa."
