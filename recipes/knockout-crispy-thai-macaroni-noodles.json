      "amount": "1 tsp"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "peanuts",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the oil in a large skillet over medium high heat.",
    "Add the sliced onion and cook until it is lightly browned.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the curry paste and cook for 1 minute, stirring constantly.",
    "Add the coconut milk and bring to a boil.",
    "Add the macaroni and cook until it is al dente.",
    "Stir in the chopped chocolate until it is melted and smooth.",
    "Season with fish sauce and salt.",
    "Transfer the macaroni to a serving platter and top with chopped peanuts.",
    "Serve immediately and enjoy."
  ],
