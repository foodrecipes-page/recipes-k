  "instructions": [
    "preheat the comal over low heat",
    "toast the italian bread on the comal until lightly browned",
    "mash the galangal in a mortar and pestle until well-crushed",
    "mix the mascarpone cheese with the parmesan cheese, olive oil, and salt",
    "stir in the crushed galangal and chopped fresh thyme",
    "spread the cheese and galangal mixture on the toasted bread",
    "place the bread on the comal and cook for 2 minutes",
    "remove from heat and let cool for 1 minute",
    "slice the torta into wedges and serve immediately"
