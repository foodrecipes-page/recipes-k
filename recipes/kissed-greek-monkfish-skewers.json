      "name": "monkfish fillet",
      "amount": "800g",
      "notes": "cut into 2cm cubes"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    },
    {
      "name": "lemon zest",
      "amount": "1 tbsp",
      "notes": "fresh"
    },
    {
      "name": "honey",
      "amount": "2 tbsp"
    },
    {
      "name": "Greek yogurt",
      "amount": "2 tbsp"
    },
    {
      "name": "fresh oregano",
      "amount": "1 tbsp",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "1 clove",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/2 tsp"
    },
    {
      "name": "white wine",
      "amount": "1/4 cup",
      "notes": "optional"
    },
    {
      "name": "skewers",
      "amount": "wooden or metal"
    }
  ],
  "instructions": [
    "Preheat grill to medium high heat at 200C.",
    "Season monkfish cubes with salt pepper lemon zest oregano and minced garlic.",
    "Thread seasoned cubes onto soaked wooden skewers.",
    "Whisk together honey olive oil white wine and Greek yogurt in a small saucepan until smooth.",
    "Simmer glaze over low heat for 3 minutes until slightly thickened.",
    "Brush glaze over skewered monkfish.",
    "Grill skewers for 2-3 minutes per side, brushing with glaze each minute.",
    "Remove skewers from grill and brush with remaining glaze.",
    "Serve immediately garnished with fresh oregano leaves."
  ],
