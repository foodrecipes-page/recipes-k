      "notes": "soaked overnight and drained"
    },
    {
      "name": "shio-koji",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "celery",
      "amount": "2 stalks",
      "notes": "chopped"
    },
    {
      "name": "diced tomatoes",
      "amount": "1 can"
    },
    {
      "name": "chicken broth",
      "amount": "4 cups"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped carrots and celery and cook until they are tender.",
    "Add the soaked and drained cannellini beans, shio-koji, diced tomatoes, chicken broth, salt, and black pepper to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 30 minutes.",
    "Use an immersion blender to puree some of the stew, leaving some of the beans and vegetables intact.",
    "Serve the stew hot, garnished with chopped fresh herbs if desired."
