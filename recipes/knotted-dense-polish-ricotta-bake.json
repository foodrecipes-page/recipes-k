{
  "title": "Knotted Dense Polish Ricotta Bake",
  "description": "A nutty and dense Polish dish featuring ricotta, perfect for a post-workout meal, this vegetarian-friendly bake is a great way to refuel.",
  "cuisine": "Polish",
  "diet": [
    "vegetarian"
  ],
