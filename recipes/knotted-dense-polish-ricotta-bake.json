  "ingredients": [
    {
      "name": "ricotta cheese",
      "amount": "16 oz",
      "notes": "drained"
    },
    {
      "name": "rolled oats",
      "amount": "1 cup"
    },
    {
      "name": "chopped walnuts",
      "amount": "1/2 cup"
    },
    {
      "name": "egg",
      "amount": "2 large"
    },
    {
      "name": "salt",
      "amount": "1/2 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1/4 tsp"
    },
    {
      "name": "dried thyme",
      "amount": "1/4 tsp"
    },
    {
      "name": "olive oil",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large bowl, combine the ricotta cheese, rolled oats, chopped walnuts, egg, salt, black pepper, and dried thyme, mixing well.",
    "Transfer the mixture to a baking dish and drizzle with olive oil.",
    "Use your hands to shape the mixture into a knotted pattern on top of the bake.",
    "Bake for 35 minutes or until the top is golden brown.",
    "Remove the bake from the oven and let it cool for a few minutes.",
    "Serve warm and enjoy."
  ],
