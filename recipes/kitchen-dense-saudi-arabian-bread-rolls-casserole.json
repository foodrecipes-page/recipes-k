      "name": "bread rolls",
      "amount": "12 rolls",
      "notes": "preferably day-old rolls"
    },
    {
      "name": "onion",
      "amount": "1 large onion",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "spices",
      "amount": "1 teaspoon",
      "notes": "including cumin, coriander, and paprika"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees.",
    "Saute the onion and garlic in olive oil until softened.",
    "Add the mushrooms and cook until they release their liquid and start to brown.",
    "Stir in the tomato paste, spices, salt, and pepper, and cook for 1 minute.",
    "Cut the bread rolls into 1-inch pieces and place half of them in the bottom of a 9x13 inch baking dish.",
    "Spoon the saute mixture over the bread rolls.",
    "Top with the remaining bread rolls.",
    "Cover the dish with aluminum foil and bake for 25 minutes.",
    "Remove the foil and bake for an additional 10 minutes, or until the top is golden brown."
  ],
