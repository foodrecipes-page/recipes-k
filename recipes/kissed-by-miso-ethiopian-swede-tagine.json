{
  "title": "kissed by miso ethiopian swede tagine",
  "description": "a citrusy, tender ethiopian dish featuring swede marinated in a rich miso paste to help cure hangovers, made in a traditional tajine clay vessel",
  "cuisine": "ethiopian",
  "diet": [
    "vegetarian",
    "gluten-free"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "swede",
      "amount": "750g",
      "notes": "cut into 2-inch cubes"
    },
    {
      "name": "miso paste",
      "amount": "4 tablespoons",
      "notes": "white miso"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1-inch piece",
      "notes": "grated"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for cooking"
    },
    {
      "name": "yellow onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon",
      "notes": "for added depth"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon",
      "notes": "freshly ground"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "2 tablespoons",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "in a small bowl whisk together miso paste, lemon juice, garlic, and ginger to make the marinade",
    "in a large bowl combine the swede cubes and the marinade, mix until the swede is well coated",
    "cover the bowl with plastic wrap and refrigerate for at least 2 hours or overnight",
    "heat the olive oil in a traditional tajine clay vessel over medium heat",
    "add the chopped onion and cook until it starts to soften, about 5 minutes",
    "add the cumin and black pepper, cook for 1 minute",
    "add the marinated swede to the tajine, stir to combine with the onion mixture",
    "cover the tajine with its lid and cook for 20 minutes, or until the swede is tender",
    "stir in some chopped parsley and serve warm"
  ],
