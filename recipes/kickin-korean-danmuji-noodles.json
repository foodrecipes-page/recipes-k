      "amount": "1 cup",
      "notes": "seasoned Korean spinach"
    },
    {
      "name": "soy sauce",
      "amount": "2 tbsp"
    },
    {
      "name": "gochujang",
      "amount": "1 tbsp",
      "notes": "Korean chili paste"
    },
    {
      "name": "sesame oil",
      "amount": "1 tsp"
    },
    {
      "name": "garlic",
      "amount": "2 cloves"
    },
    {
      "name": "green onions",
      "amount": "1/4 cup",
      "notes": "thinly sliced"
    }
  ],
  "instructions": [
    "Cook the rice noodles according to the package instructions and set aside.",
    "In a large skillet, heat the sesame oil over medium heat.",
    "Add the minced garlic and cook for 1 minute until fragrant.",
    "Add the namul and cook for 2 minutes until wilted.",
    "Add the gochujang and soy sauce, and stir to combine.",
    "Add the cooked noodles to the skillet and stir to combine with the namul mixture.",
    "Add the danmuji and stir to combine.",
    "Cook for an additional 2 minutes until the noodles are well coated.",
    "Transfer the noodles to a serving dish and garnish with green onions.",
    "Serve immediately and enjoy."
  ],
