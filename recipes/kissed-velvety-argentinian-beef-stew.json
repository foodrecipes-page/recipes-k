      "name": "beef short ribs",
      "amount": "2 pounds",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "perilla leaves",
      "amount": "1 bunch",
      "notes": "chopped"
    },
    {
      "name": "onions",
