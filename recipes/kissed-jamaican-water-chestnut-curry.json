      "amount": "1 tablespoon"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 teaspoon",
      "notes": "grated"
    },
    {
      "name": "curry powder",
      "amount": "1 teaspoon"
    },
    {
