  "ingredients": [
    {
      "name": "boneless chicken thighs",
      "amount": "1 1/2 pounds",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "chili powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "curry powder",
      "amount": "1 tablespoon"
    },
    {
      "name": "coconut milk",
      "amount": "1 can"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "mustard oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    }
  ],
  "instructions": [
    "Heat the mustard oil in a large pan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for 1 minute.",
    "Add the chicken pieces and cook until they are browned.",
    "Add the chili powder, curry powder, salt, and black pepper, and stir to combine.",
    "Pour in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the curry simmer for 20 minutes.",
    "Serve the curry in a dolsot stone bowl.",
    "Garnish with chopped fresh cilantro, if desired."
  ],
