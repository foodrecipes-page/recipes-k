{
  "title": "Kicked Spicy Malaysian Chicken Curry",
  "description": "A spicy and flavorful Malaysian chicken curry dish made with chili powder and served in a dolsot stone bowl, perfect for a lazy Sunday lunch.",
  "cuisine": "Malaysian",
  "diet": [
    "sugar-free",
