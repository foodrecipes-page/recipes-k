{
  "title": "Kissed Molten Egyptian Lamb Tagine",
  "description": "A cozy Egyptian dish featuring herbal and molten flavors, served in a stone bowl with chilled butter, this paleo-friendly recipe is perfect for a cold evening.",
  "cuisine": "Egyptian",
  "diet": [
    "paleo"
  ],
