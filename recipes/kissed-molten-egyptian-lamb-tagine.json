  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "boneless, cut into 2 inch pieces"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "2 inches",
      "notes": "peeled, grated"
    },
    {
      "name": "cumin",
      "amount": "2 teaspoons",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "cayenne pepper",
      "amount": "0.5 teaspoon",
      "notes": "or more to taste"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": ""
    },
    {
      "name": "black pepper",
      "amount": "0.5 teaspoon",
      "notes": ""
    },
    {
      "name": "chilled butter",
      "amount": "4 tablespoons",
      "notes": ""
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit.",
    "In a large bowl, combine lamb, onion, garlic, ginger, cumin, coriander, cayenne pepper, salt, and black pepper, and mix well.",
    "Transfer the mixture to a stone bowl or a clay tagine with a tight-fitting lid.",
    "Cover the bowl with foil and bake for 2.5 hours.",
    "Remove the foil and continue baking for an additional 30 minutes, or until the lamb is tender and the sauce is thickened.",
    "Remove the bowl from the oven and let it cool for a few minutes.",
    "Stir in the chilled butter until it is melted and the sauce is smooth.",
    "Serve the tagine hot, garnished with fresh herbs if desired."
  ],
