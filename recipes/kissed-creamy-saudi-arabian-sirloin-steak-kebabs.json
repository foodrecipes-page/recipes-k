{
  "title": "Kissed Creamy Saudi Arabian Sirloin Steak Kebabs",
  "description": "A jammy and creamy post-workout Saudi Arabian dish featuring sirloin steak, this recipe is egg-free friendly and perfect for serving on a slate tile vessel.",
  "cuisine": "Saudi Arabian",
  "diet": [
    "gluten-free",
    "egg-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "sirloin steak",
      "amount": "1.5 pounds",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "plain yogurt",
      "amount": "1 cup",
      "notes": "low fat"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat the grill to medium high heat.",
    "In a large bowl, whisk together the yogurt, lemon juice, olive oil, garlic powder, paprika, salt, and black pepper.",
    "Add the sirloin steak cubes to the bowl and toss to coat with the marinade.",
    "Thread the marinated steak cubes onto skewers, leaving a small space between each cube.",
    "Grill the kebabs for 8-10 minutes, turning occasionally, until the steak is cooked to an internal temperature of 145 degrees.",
    "Let the kebabs rest for 5 minutes before serving.",
    "Garnish with chopped fresh parsley and serve on a slate tile vessel.",
    "Serve hot and enjoy.",
    "Refrigerate any leftovers promptly."
  ],
