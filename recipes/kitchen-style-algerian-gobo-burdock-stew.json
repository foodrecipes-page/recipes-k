      "notes": "peeled and sliced"
    },
    {
      "name": "lardons",
      "amount": "6 slices",
      "notes": "rendered"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat",
    "Add the lardons and cook until crispy, then set aside",
    "Add the onion and garlic to the pot and cook until the onion is translucent",
    "Add the gobo burdock, carrots, and potatoes to the pot, and cook for 5 minutes",
    "Stir in the tomato paste and cook for 1 minute",
    "Add the vegetable broth, salt, and black pepper to the pot, and bring to a boil",
    "Reduce the heat to low and simmer, covered, for 30 minutes",
    "Stir in the cooked lardons and serve hot"
  ],
